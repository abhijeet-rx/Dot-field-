# ──────────────────────────────────────────────────────────
# DOT Field — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.
# ──────────────────────────────────────────────────────────

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/dot_field
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# Security & JWT Configuration
# Generate a secure 256-bit hex key (at least 32 characters):
#   openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_at_least_32_characters
JWT_EXPIRATION=86400000

# Initial Admin Bootstrap (Optional)
# If set, the user registering with this email will be assigned the ADMIN role.
INITIAL_ADMIN_EMAIL=admin@example.com

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
