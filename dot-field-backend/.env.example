# ──────────────────────────────────────────────────────────
# DOT Field — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.
# ──────────────────────────────────────────────────────────

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/dot_field
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# Security & JWT Configuration
# Generate a secure 256-bit hex key (at least 32 characters):
#   openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_at_least_32_characters
JWT_EXPIRATION=86400000

# Initial Admin Bootstrap (Optional)
# If set, the user registering with this email will be assigned the ADMIN role.
INITIAL_ADMIN_EMAIL=admin@example.com

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Job Sources Configuration (India-First Platform)
COMPANY_CAREERS_ENABLED=false
REMOTIVE_ENABLED=false

# Real Job API Sources
INDIANAPI_ENABLED=true
INDIANAPI_KEY=your_indianapi_key_here

JOOBLE_ENABLED=true
JOOBLE_API_KEY=your_jooble_api_key_here

ADZUNA_ENABLED=true
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Optional Partner API Credentials (Disabled by default until credentials provided)
NAUKRI_ENABLED=false
NAUKRI_CLIENT_ID=your_naukri_partner_client_id
NAUKRI_CLIENT_SECRET=your_naukri_partner_client_secret

FOUNDIT_ENABLED=false
FOUNDIT_CLIENT_ID=your_foundit_partner_client_id
FOUNDIT_CLIENT_SECRET=your_foundit_partner_client_secret

INDEED_ENABLED=false
INDEED_PUBLISHER_ID=your_indeed_publisher_id

# Scheduled Job Ingestion Configuration (Optional Overrides)
# JOB_INGESTION_SCHEDULER_ENABLED=true
# JOB_INGESTION_SCHEDULER_FIXED_DELAY_MS=1800000
# JOB_INGESTION_SCHEDULER_INITIAL_DELAY_MS=60000
# JOB_INGESTION_SCHEDULER_MAX_RESULTS=50
